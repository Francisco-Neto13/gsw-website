{"nodes": [{"id": "docs_redesign_direcao_visual_direcao_visual", "label": "Direcao visual (proposal)", "file_type": "document", "source_file": "docs/redesign/direcao-visual.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_redesign_direcao_visual_caixa_de_item", "label": "Caixa de Item (proposed visual direction)", "file_type": "rationale", "source_file": "docs/redesign/direcao-visual.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the in-game item tooltip language to frame reference info while reading text stays in a calm column; rejects neon cards and medieval titles. Risk: becomes costume if overused, so one ficha per page and box only on reference info."}, {"id": "docs_redesign_direcao_visual_palette", "label": "Contained palette (violet-tinted darks, action violet)", "file_type": "concept", "source_file": "docs/redesign/direcao-visual.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand violet #7116AD only as fill: as text it gives 2.0:1, today's error."}, {"id": "docs_redesign_direcao_visual_rarity_colors", "label": "Rarity colors as functional language", "file_type": "concept", "source_file": "docs/redesign/direcao-visual.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color is never the only signal."}, {"id": "docs_redesign_direcao_visual_typography", "label": "Typography (Pixelify Sans, Alegreya Sans, JetBrains Mono via next/font)", "file_type": "concept", "source_file": "docs/redesign/direcao-visual.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic pixel font, not Minecraft's font (Mojang trademark); OFL fonts self-hosted."}, {"id": "docs_redesign_direcao_visual_ficha_do_guia", "