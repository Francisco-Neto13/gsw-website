{
  "name": "gsw-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "convert:webp": "node scripts/convert-to-webp.mjs"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "gifsicle": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
