# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage


# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# image workbench
/image-workbench/input/*
!/image-workbench/input/.gitkeep
/image-workbench/output/*
!/image-workbench/output/.gitkeep

# local backups
/backup/

# graphify: versiona o grafo, o relatório, o manifesto, os rótulos e o cache semântico (docs/GRAFO.md)
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json
!/graphify-out/.graphify_labels.json
!/graphify-out/cache/
/graphify-out/cache/*
!/graphify-out/cache/semantic/

# hooks do graphify e config local do Claude Code: têm caminhos desta máquina; cada clone instala os seus
/.githooks/post-*
/.claude/settings.json
/.claude/settings.local.json
